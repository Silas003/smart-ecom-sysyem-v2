type Product {
  id: ID!
  name: String!
  price: Float!
  stockQuantity: Int!
  category: Category
}

input ProductInput {
  name: String!
  price: Float!
  stockQuantity: Int!
  categoryId: ID!
}

type ProductPage {
  items: [Product!]!
  totalCount: Int!
}

type Query {
  products(page:Int!,size:Int!): ProductPage!
  productById(id: ID!): Product
}

type Mutation {
  createProduct(input: ProductInput!): Product!
  updateProduct(id: ID!, input: ProductInput!): Product!
  deleteProduct(id: ID!): Boolean!
}

type Category {
  id: ID!
  name: String!
}

input CategoryInput {
  name: String!
}

type User {
  id: ID!
  username: String!
  email: String!
  userRole: String
}

input UserInput {
  username: String!
  email: String!
  password: String!
  userRole: String
}

type Review {
  id: ID!
  product: Product
  user: User
  rating: Int!
  description: String
}

input ReviewInput {
  userId: ID!
  productId: ID!
  rating: Int!
  description: String
}

type Inventory {
  id: ID!
  product: Product
  stockQuantity: Int!
  reservedQuantity: Int!
  stockStatus: String!
}

input InventoryInput {
  productId: ID!
  stockQuantity: Int!
  reservedQuantity: Int!
  stockStatus: String!
}

extend type Query {
  categories: [Category!]!
  categoryById(id: ID!): Category
  users(page:Int!,size:Int!): [User!]!
  userById(id: ID!): User
  reviews: [Review!]!
  reviewById(id: ID!): Review
  reviewsByProduct(productId: ID!): [Review!]!
  reviewsByUser(userId: ID!): [Review!]!
  inventories: [Inventory!]!
  inventoryById(id: ID!): Inventory
}

extend type Mutation {
  createCategory(input: CategoryInput!): Category!
  updateCategory(id: ID!, input: CategoryInput!): Category!
  deleteCategory(id: ID!): Boolean!

  createUser(input: UserInput!): User!
  updateUser(id: ID!, input: UserInput!): User!
  deleteUser(id: ID!): Boolean!

  createReview(input: ReviewInput!, userId: ID!): Review!
  deleteReview(id: ID!, userId: ID!): Boolean!

  createInventory(input: InventoryInput!): Inventory!
  updateInventory(id: ID!, input: InventoryInput!): Inventory!
  deleteInventory(id: ID!): Boolean!
}


enum OrderStatus {
  pending
  processing
  delivered
  cancelled
}

type OrderItem {
  id: ID!
  product: Product
  quantity: Int!
  unitPrice: Float!
  totalPrice: Float!
}

input OrderItemInput {
  productId: ID!
  quantity: Int!
}

type Order {
  id: ID!
  userId: ID!
  status: OrderStatus!
  totalAmount: Float!
  items: [OrderItem!]!
  createdAt: String
}

input OrderInput {
  userId: ID!
  items: [OrderItemInput!]!
}

extend type Query {
  orders(page:Int!,size:Int!): [Order!]!
  orderById(id: ID!): Order
}

extend type Mutation {
  createOrder(input: OrderInput!): Order!
  updateOrderStatus(id: ID!, status: OrderStatus!): Order!
  deleteOrder(id: ID!): Boolean!
}
